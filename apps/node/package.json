{
  "name": "@haus/node",
  "license": "GPL-3.0-or-later",
  "version": "0.3.47",
  "private": true,
  "type": "module",
  "description": "Optional storage and media streaming workers for Haus",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @haus/hub start",
    "telemetry": "pnpm --filter @haus/hub telemetry",
    "test": "pnpm --filter @haus/hub exec vitest run test/runtime/discovery.test.ts test/runtime/monitoring.test.ts test/runtime/workspace.test.ts test/nvr/storage/workspace.test.ts",
    "check": "pnpm test",
    "test:integration": "node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@homebridge/ciao": "1.4.0",
    "@haus/hub": "workspace:*",
    "@haus/homekit": "workspace:*",
    "@haus/media": "workspace:*",
    "@haus/kitsune": "workspace:*",
    "@haus/servers": "workspace:*",
    "@haus/ai": "workspace:*",
    "@haus/core": "workspace:*"
  }
}
