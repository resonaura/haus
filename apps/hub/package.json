{
  "name": "@haus/hub",
  "license": "GPL-3.0-or-later",
  "version": "0.3.76",
  "private": true,
  "type": "module",
  "description": "Local camera event recordings and services for Haus",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "check": "pnpm typecheck && pnpm test",
    "telemetry": "node dist/cli/telemetry.js",
    "recover": "node dist/cli/recover.js"
  },
  "exports": {
    "./auth": {
      "types": "./src/auth/index.ts",
      "development": "./src/auth/index.ts",
      "default": "./dist/auth/index.js"
    },
    "./control": {
      "types": "./src/control/index.ts",
      "development": "./src/control/index.ts",
      "default": "./dist/control/index.js"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "development": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "development": "./src/events/index.ts",
      "default": "./dist/events/index.js"
    },
    "./backup": {
      "types": "./src/backup/index.ts",
      "development": "./src/backup/index.ts",
      "default": "./dist/backup/index.js"
    },
    "./preferences": {
      "types": "./src/preferences/index.ts",
      "development": "./src/preferences/index.ts",
      "default": "./dist/preferences/index.js"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "development": "./src/providers/index.ts",
      "default": "./dist/providers/index.js"
    },
    "./cluster": {
      "types": "./src/cluster/index.ts",
      "development": "./src/cluster/index.ts",
      "default": "./dist/cluster/index.js"
    },
    "./homekit": {
      "types": "./src/homekit/index.ts",
      "development": "./src/homekit/index.ts",
      "default": "./dist/homekit/index.js"
    },
    "./servers": {
      "types": "./src/servers/index.ts",
      "development": "./src/servers/index.ts",
      "default": "./dist/servers/index.js"
    },
    "./status": {
      "types": "./src/status/index.ts",
      "development": "./src/status/index.ts",
      "default": "./dist/status/index.js"
    },
    "./camera": {
      "types": "./src/camera/index.ts",
      "development": "./src/camera/index.ts",
      "default": "./dist/camera/index.js"
    },
    "./stream": {
      "types": "./src/stream/index.ts",
      "development": "./src/stream/index.ts",
      "default": "./dist/stream/index.js"
    },
    "./nvr": {
      "types": "./src/nvr/index.ts",
      "development": "./src/nvr/index.ts",
      "default": "./dist/nvr/index.js"
    },
    "./nest": {
      "types": "./src/nest.ts",
      "development": "./src/nest.ts",
      "default": "./dist/nest.js"
    },
    ".": {
      "types": "./src/main.ts",
      "development": "./src/main.ts",
      "default": "./dist/main.js"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "development": "./src/http/index.ts",
      "default": "./dist/http/index.js"
    },
    "./ha": {
      "types": "./src/ha/index.ts",
      "development": "./src/ha/index.ts",
      "default": "./dist/ha/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "development": "./src/runtime/index.ts",
      "default": "./dist/runtime/index.js"
    },
    "./cli/recover": {
      "types": "./src/cli/recover.ts",
      "development": "./src/cli/recover.ts",
      "default": "./dist/cli/recover.js"
    }
  },
  "files": [
    "dist",
    "web"
  ],
  "dependencies": {
    "@haus/ai": "workspace:*",
    "@haus/apps": "workspace:*",
    "@haus/bridge": "workspace:*",
    "@haus/core": "workspace:*",
    "@haus/ha": "workspace:*",
    "@haus/homekit": "workspace:*",
    "@haus/kitsune": "workspace:*",
    "@haus/matter": "workspace:*",
    "@haus/media": "workspace:*",
    "@haus/mqtt": "workspace:*",
    "@haus/servers": "workspace:*",
    "@haus/thread": "workspace:*",
    "@haus/zigbee": "workspace:*",
    "@homebridge/ciao": "1.4.0",
    "@homebridge/dbus-native": "0.7.9",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/platform-ws": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/websockets": "^12.3.3",
    "better-sqlite3": "12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "1.1.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2"
  }
}
