{
  "name": "@haus/ui",
  "license": "GPL-3.0-or-later",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "react-native": "./src/tokens/index.ts",
      "development": "./src/tokens/index.ts",
      "default": "./dist/tokens/index.js"
    },
    "./categories": {
      "types": "./src/categories/index.ts",
      "react-native": "./src/categories/index.ts",
      "development": "./src/categories/index.ts",
      "default": "./dist/categories/index.js"
    },
    "./controls": {
      "types": "./src/controls/index.ts",
      "react-native": "./src/controls/index.ts",
      "development": "./src/controls/index.ts",
      "default": "./dist/controls/index.js"
    },
    "./formatters": {
      "types": "./src/formatters/index.ts",
      "react-native": "./src/formatters/index.ts",
      "development": "./src/formatters/index.ts",
      "default": "./dist/formatters/index.js"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "react-native": "./src/components/index.ts",
      "development": "./src/components/index.ts",
      "default": "./dist/components/index.js"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "react-native": "./src/charts/index.ts",
      "development": "./src/charts/index.ts",
      "default": "./dist/charts/index.js"
    },
    "./ir": {
      "types": "./src/ir/index.ts",
      "react-native": "./src/ir/index.ts",
      "development": "./src/ir/index.ts",
      "default": "./dist/ir/index.js"
    },
    "./compiler": {
      "types": "./src/compiler/index.ts",
      "react-native": "./src/compiler/index.ts",
      "development": "./src/compiler/index.ts",
      "default": "./dist/compiler/index.js"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "react-native": "./src/generated/index.ts",
      "development": "./src/generated/index.ts",
      "default": "./dist/generated/index.js"
    },
    "./renderers": {
      "types": "./src/renderers/index.ts",
      "react-native": "./src/renderers/index.ts",
      "development": "./src/renderers/index.ts",
      "default": "./dist/renderers/index.js"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "react-native": "./src/primitives/index.ts",
      "development": "./src/primitives/index.ts",
      "default": "./dist/primitives/index.js"
    },
    "./styles": {
      "types": "./src/styles/index.ts",
      "react-native": "./src/styles/index.ts",
      "development": "./src/styles/index.ts",
      "default": "./dist/styles/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync, mkdirSync, readdirSync } from 'node:fs'; mkdirSync('dist/shaders', { recursive: true }); for (const f of readdirSync('src/shaders')) { if (f.endsWith('.glsl') || f.endsWith('.wgsl')) cpSync('src/shaders/' + f, 'dist/shaders/' + f); }\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@haus/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
