{
  "name": "@haus/ipc",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Direct E2EE binary IPC transport, cryptography, client, and server stream runtimes for Haus",
  "engines": {
    "node": ">=24.11.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "development": "./src/crypto.ts",
      "default": "./dist/crypto.js"
    },
    "./transport": {
      "types": "./src/transport.ts",
      "development": "./src/transport.ts",
      "default": "./dist/transport.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "development": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync, mkdirSync } from 'node:fs'; mkdirSync('dist/server', { recursive: true }); cpSync('src/server/pty-bridge.py', 'dist/server/pty-bridge.py');\"",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@haus/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
