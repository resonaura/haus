{
  "name": "@haus/zigbee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./clusters": {
      "types": "./src/clusters.ts",
      "default": "./dist/clusters.js"
    },
    "./coordinator": {
      "types": "./src/coordinator.ts",
      "default": "./dist/coordinator.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@haus/core": "workspace:*",
    "zigbee-herdsman": "^11.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
