{
  "name": "@haus/homekit",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Per-camera HomeKit identities, HKSV recording and leased SRTP media",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./controller": {
      "types": "./src/controller.ts",
      "default": "./dist/controller.js"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./dist/media.js"
    },
    "./fragments": {
      "types": "./src/fragments.ts",
      "default": "./dist/fragments.js"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "default": "./dist/bridge.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./standalone": {
      "types": "./src/standalone.ts",
      "default": "./dist/standalone.js"
    },
    "./passthrough": {
      "types": "./src/passthrough.ts",
      "default": "./dist/passthrough.js"
    },
    "./transfer": {
      "types": "./src/transfer.ts",
      "default": "./dist/transfer.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@homebridge/hap-nodejs": "2.3.0",
    "@haus/core": "workspace:*",
    "@haus/media": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
