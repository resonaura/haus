    "fork:build": "node scripts/fork.ts",
    "fork:patches": "node scripts/fork.ts --export-patches"
  },
  "dependencies": {
    "@gpuix/native": "workspace:*",
    "@gpuix/react": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
