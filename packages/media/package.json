{
  "name": "@haus/media",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Shared camera source validation and media transport contracts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/source.ts",
      "default": "./dist/source.js"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./dist/snapshot.js"
    },
    "./failure": {
      "types": "./src/failure.ts",
      "default": "./dist/failure.js"
    },
    "./activity": {
      "types": "./src/activity.ts",
      "default": "./dist/activity.js"
    },
    "./access": {
      "types": "./src/access.ts",
      "default": "./dist/access.js"
    },
    "./peer": {
      "types": "./src/peer.ts",
      "default": "./dist/peer.js"
    },
    "./process": {
      "types": "./src/process.ts",
      "default": "./dist/process.js"
    },
    "./recording": {
      "types": "./src/recording.ts",
      "default": "./dist/recording.js"
    },
    "./ring": {
      "types": "./src/ring.ts",
      "default": "./dist/ring.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@haus/kitsune": "workspace:*"
  }
}
