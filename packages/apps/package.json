{
  "name": "@haus/apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./docker": {
      "types": "./src/docker.ts",
      "default": "./dist/docker.js"
    },
    "./socket": {
      "types": "./src/socket.ts",
      "default": "./dist/socket.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "default": "./dist/policy.js"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts",
      "default": "./dist/lifecycle.js"
    },
    "./image": {
      "types": "./src/image.ts",
      "default": "./dist/image.js"
    },
    "./environment": {
      "types": "./src/environment.ts",
      "default": "./dist/environment.js"
    },
    "./dag": {
      "types": "./src/dag.ts",
      "default": "./dist/dag.js"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "default": "./dist/host/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@haus/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
