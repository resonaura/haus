{
  "name": "@haus/mqtt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./broker": {
      "types": "./src/broker.ts",
      "default": "./dist/broker.js"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./dist/router.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@haus/core": "workspace:*",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
