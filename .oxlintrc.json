{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "out/**",
    "dist/**",
    "release/**",
    "node_modules/**",
    "apps/hub/**/*.mjs",
    "apps/hub/**/*.js",
    "apps/node/**"
  ],
  "rules": { "no-unused-vars": "warn" }
}
